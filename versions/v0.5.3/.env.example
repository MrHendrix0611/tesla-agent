# Exemplo publico - nunca versione suas chaves reais.
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=groq,gemini,openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_MODEL=qwen2.5-coder:3b
MAX_DAILY_GROQ_CALLS=0
MAX_DAILY_GEMINI_CALLS=0
MAX_DAILY_OPENROUTER_CALLS=0
PROVIDER_COOLDOWN_SECONDS=15
RATE_LIMIT_COOLDOWN_SECONDS=120
USAGE_LOG_PATH=data/usage.jsonl
PAID_FALLBACK_ENABLED=false
MONTHLY_PAID_BUDGET_USD=0
PAID_RESERVED_OUTPUT_TOKENS=1024
OPENROUTER_INPUT_USD_PER_M=0
OPENROUTER_OUTPUT_USD_PER_M=0
PAID_USAGE_MODE=never
